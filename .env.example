# AWS Secrets Manager handles DB_HOST, DB_PORT, DB_USER, DB_PASSWORD
# These env vars are only needed if AWS is unavailable (local dev fallback)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Project-specific — always from env, never from AWS
DB_NAME=funeral_homes

# Local dev fallback (only used if AWS Secrets Manager is unavailable)
# DB_HOST=db99.rds.blockshopper.com
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
